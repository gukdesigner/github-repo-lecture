<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration
        PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
        "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">
<generatorConfiguration>

	<!--
		[修正01] PostgreSQL JDBC ドライバーのパス指定
		変更前: PostgreSQL ドライバー未設定
		変更後: ローカル Maven リポジトリ（.m2）の postgresql-42.7.8.jar を直接指定
		理由  : MBG（MyBatis Generator）実行時に DB 接続で使用する JDBC ドライバーを
		        クラスパスに登録する必要があるため、実ファイルパスを明示する
	-->
	<classPathEntry
		location="C:\\Users\\saogi\\.m2\\repository\\org\\postgresql\\postgresql\\42.7.8\\postgresql-42.7.8.jar" />

	<context id="PostgresContext" targetRuntime="MyBatis3"
		defaultModelType="flat">

		<commentGenerator>
			<property name="suppressDate" value="true" />
			<!-- 自動生成コメントの抑制: false = コメントを出力する -->
			<property name="suppressAllComments" value="false" />
		</commentGenerator>

		<!--
			[修正02] JDBC 接続 URL の変更および PostgreSQL 専用プロパティの追加
			変更前: connectionURL のクエリパラメーターに nullCatalogMeansCurrent=true を含めていた
			変更後: connectionURL からクエリパラメーターを除去し、同設定を <property> タグで分離
			理由  : PostgreSQL は複数スキーマ（catalog）を持つため、この設定がないと
			        MBG がシステムテーブルも読み込んで重複生成エラーが発生する。
			        <property> 方式の方が PostgreSQL JDBC ドライバーとの互換性が安定している。
		-->
		<jdbcConnection driverClass="org.postgresql.Driver"
			connectionURL="jdbc:postgresql://localhost:5432/postgres"
			userId="postgres" password="postgres">
			<!-- 現在接続中の DB（catalog）のテーブル情報のみ取得するよう制限する -->
			<property name="nullCatalogMeansCurrent" value="true" />
		</jdbcConnection>

		<javaTypeResolver>
			<!-- NUMERIC/DECIMAL 型を BigDecimal ではなく Integer/Long 等にマッピングすることを許可 -->
			<property name="forceBigDecimals" value="false" />
		</javaTypeResolver>

		<!-- 生成するモデル（VO/Entity）クラスのパッケージおよび出力先 -->
		<javaModelGenerator
			targetPackage="com.kyh.system.model" targetProject="src/main/java">
			<property name="enableSubPackages" value="true" />
			<property name="trimStrings" value="true" />
		</javaModelGenerator>

		<!-- 生成するマッパー XML ファイルの出力先 -->
		<sqlMapGenerator targetPackage="mapper"
			targetProject="src/main/resources">
			<property name="enableSubPackages" value="true" />
		</sqlMapGenerator>

		<!-- 生成するマッパーインターフェース（Java）のパッケージおよび出力先 -->
		<javaClientGenerator type="XMLMAPPER"
			targetPackage="com.kyh.system.mapper" targetProject="src/main/java">
			<property name="enableSubPackages" value="true" />
		</javaClientGenerator>

		<!--
			[修正03] 対象テーブルの変更および tg_setting テーブルの追加

			① syain_main テーブル
			   変更: generatedKey 設定を追加
			   ※ schema="public" 属性は意図的に除去（下記「パス生成の問題」参照）
			   理由: syain_id カラムは SERIAL（自動採番）のため、JDBC の generatedKey を指定することで
			         INSERT 直後に生成された PK 値を Java オブジェクト（SyainMain.syainId）へ
			         自動反映できる。登録後のリダイレクト等で別途 SELECT を発行せずに ID を使用可能。

			   ※ [schema 属性除去の理由]
			   変更前: schema="public" を明示 → MBG がスキーマ名をパッケージパスに含め、
			           com.kyh.system.model.public.SyainMain 等の意図しないサブディレクトリが生成された
			   変更後: schema 属性を除去 → nullCatalogMeansCurrent=true により
			           すでに現在 DB の public スキーマのみを対象としているため、
			           schema 属性なしでも同様に動作し、不要なサブパッケージ生成を防止できる
		-->
		<table tableName="syain_main" domainObjectName="SyainMain">
			<!-- syain_id: SERIAL カラム → INSERT 後に生成されたキー値をオブジェクトへ自動反映 -->
			<generatedKey column="syain_id" sqlStatement="JDBC"
				identity="true" />
		</table>

		<table tableName="tg_setting" domainObjectName="TgSetting" />

		<table tableName="user_auth" domainObjectName="UserAuth">
			<generatedKey column="user_id" sqlStatement="JDBC"
				identity="true" />
		</table>

	</context>
</generatorConfiguration>
